{
  "name": "openclaw-memgpt",
  "version": "1.1.0",
  "type": "module",
  "description": "MemGPT memory backend for OpenClaw — three-tier memory architecture via pymemgpt sidecar",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "memgpt",
    "ai-memory",
    "long-term-memory",
    "agent-memory",
    "llm"
  ],
  "homepage": "https://github.com/xltvy/openclaw-memgpt#readme",
  "bugs": {
    "url": "https://github.com/xltvy/openclaw-memgpt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xltvy/openclaw-memgpt.git"
  },
  "author": "Altay Acar",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "src/",
    "dist/",
    "sidecar/",
    "!sidecar/tests/**",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "!sidecar/.python-version",
    "!sidecar/litellm_config.yaml",
    "openclaw.plugin.json",
    "openclaw-plugin-sdk.d.ts"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28"
    },
    "install": {
      "npmSpec": "openclaw-memgpt",
      "minHostVersion": ">=2026.5.31"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --splitting --outdir=dist",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.ts tests/*/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1"
  }
}
